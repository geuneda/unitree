/* Layout only: the look comes from the UI kit (ah-panel, ah-title, ah-key, ah-value, ah-hint, ah-button). */
.hud {
    position: absolute;
    left: 32px;
    top: 28px;
    min-width: 260px;
}

.hud__gauge {
    margin-top: 2px;
    margin-bottom: 8px;
}

.hud__reverse {
    position: absolute;
    right: 32px;
    bottom: 28px;
}
