<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="SmokeHud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:Label name="title" class="hud__title" text="AGENT HARNESS / SMOKE" />
        <ui:VisualElement class="hud__row">
            <ui:Label class="hud__key" text="LAPS" />
            <ui:Label name="laps" class="hud__value" text="0" />
        </ui:VisualElement>
        <ui:VisualElement class="hud__row">
            <ui:Label class="hud__key" text="SPIN" />
            <ui:Label name="dir" class="hud__value" text="CW" />
        </ui:VisualElement>
        <ui:Label class="hud__hint" text="SPACE  reverse" />
    </ui:VisualElement>
</ui:UXML>
